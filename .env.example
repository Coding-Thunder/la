# ----------------------------------------------------------------------------
# LexReview — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ----------------------------------------------------------------------------

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ----------
GEMINI_API_KEY=your-gemini-api-key
# Fast + cheap + multimodal. Upgrade to gemini-2.5-pro for harder documents.
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase client config (Project settings > General > Your apps) ---------
# These are PUBLIC by design (shipped to the browser). Security comes from
# Firebase Auth + Firestore/Storage rules, not from hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server only — Project settings > Service accounts) --
# Paste the FULL service-account JSON on a single line (escaped).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# --- Access control ----------------------------------------------------------
# Comma-separated emails allowed to use the app. Leave blank to allow anyone
# who signs in with Google (NOT recommended — your Gemini bill is exposed).
ALLOWED_EMAILS=lawyer1@firm.com,lawyer2@firm.com

# Max daily analyses per user (simple abuse / cost guard).
DAILY_ANALYSIS_LIMIT=25
