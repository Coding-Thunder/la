rules_version = '2';

// LexReview Storage rules.
// Files live under users/{uid}/... and are private to that user.
// Uploads are capped at 20MB and limited to PDF / Word documents.

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/msword'
        );
    }
  }
}
